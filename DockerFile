# ใช้ Node.js base image ที่มี OpenSSL 3 ติดมาด้วย
FROM node:20-slim

RUN rm -rf node_modules

# ติดตั้ง curl และ unzip (จำเป็นสำหรับติดตั้ง Bun)
RUN apt-get update && apt-get install -y curl unzip && apt-get clean

# ติดตั้ง Bun รุ่นล่าสุด
RUN curl -fsSL https://bun.sh/install | bash && \
    ln -s /root/.bun/bin/bun /usr/local/bin/bun

# ตรวจสอบ Bun version
RUN bun --version

# ทำงานในโฟลเดอร์ /app
WORKDIR /app

# คัดลอกโค้ดไปยัง container
COPY . .

# ติดตั้ง dependencies
RUN bun install

# ลบ node_modules ที่ติดมาจาก local ทุกครั้ง
RUN rm -rf node_modules

# ติดตั้ง dependencies ด้วย NPM (ตามที่คุณต้องการ)
RUN npm install

# สร้าง Prisma Client ใหม่ (ในกรณีที่ใช้)
RUN bunx prisma generate

# เปิดพอร์ต 3000
EXPOSE 3000

# สั่งรันแอป (เช่น index.ts หรือ main.ts)
CMD ["bun", "run", "index.ts"]
