# ใช้ Node.js base image ที่มี OpenSSL 3 ติดมาด้วย
FROM node:22-alpine

# อัปเดตระบบและติดตั้งเครื่องมือที่จำเป็น
RUN apk update && apk add --no-cache curl unzip openssl
RUN sudo apt update && sudo apt install libssl3 openssl

# ติดตั้ง Bun รุ่นล่าสุด
RUN curl -fsSL https://bun.sh/install | bash && \
    ln -s /root/.bun/bin/bun /usr/local/bin/bun

# ตรวจสอบ Bun version
RUN bun --version

RUN node -v

# ตั้งค่าโฟลเดอร์ทำงาน
WORKDIR /app

# คัดลอกโค้ดไปยัง container
COPY . .

# ติดตั้ง dependencies
RUN bun install

# สร้าง Prisma Client ใหม่ (ในกรณีที่ใช้)
RUN bun x prisma generate

# เปิดพอร์ต 3000
EXPOSE 3000

ENV OPENSSL_DIR=/usr/lib
ENV LD_LIBRARY_PATH=/usr/lib

# สั่งรันแอป (เช่น index.ts หรือ main.ts)
CMD ["bun", "run", "index.ts"]